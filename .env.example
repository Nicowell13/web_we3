# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# App Config
PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# Firebase Authentication (Client)
NEXT_PUBLIC_FIREBASE_API_KEY=mock-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wetri-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wetri-dev
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wetri-dev.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef

# Firebase Admin SDK (Server)
FIREBASE_PROJECT_ID=wetri-dev
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@wetri-dev.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMOCK_KEY\n-----END PRIVATE KEY-----\n"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=wetri
CLOUDINARY_API_KEY=mock-key
CLOUDINARY_API_SECRET=mock-secret

# DOKU Payment Gateway
DOKU_CLIENT_ID=MOCK_DOKU_CLIENT_ID
DOKU_SECRET_KEY=MOCK_DOKU_SECRET_KEY
DOKU_SHARED_KEY=MOCK_DOKU_SHARED_KEY
DOKU_ENV=sandbox

# Digiflazz Multi-Supplier
DIGIFLAZZ_USERNAME=mock_username
DIGIFLAZZ_API_KEY=mock_api_key
DIGIFLAZZ_ENV=dev
